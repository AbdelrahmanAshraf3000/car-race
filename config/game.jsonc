{
    "start-scene" : "menu",
    "window":
    {
        "title":"OpenKartCPP",
        "size":{
            "width":1280,
            "height":720
        },
        "fullscreen": false
    },
    "scene": {
        "renderer":{
            "sky": "assets/textures/skyorig.png"
            // "postprocess": "assets/shaders/postprocess/arcade.frag"
        },
        "assets":{
            "shaders":{
                "tinted":{
                    "vs":"assets/shaders/tinted.vert",
                    "fs":"assets/shaders/tinted.frag"
                },
                "textured":{
                    "vs":"assets/shaders/textured.vert",
                    "fs":"assets/shaders/textured.frag"
                },
                "light":{
                    "vs":"assets/shaders/light.vert",
                    "fs":"assets/shaders/light.frag"
                }
            },
            "textures":{
                "moon": "assets/textures/moon.jpg",
                "grass": "assets/textures/grass_ground_d.jpg",
                "wood": "assets/textures/wood.jpg",
                "glass": "assets/textures/glass-panels.png",
                "monkey": "assets/textures/monkey.png",
                "emission": "assets/textures/emissive.jpg",
                "roughness": "assets/textures/roughness.jpg",
                "specular": "assets/textures/specular.jpg",
                "albedo": "assets/textures/albedo.jpg",
                "ambient": "assets/textures/ambient_occlusion.jpg",
                "plane-roughness": "assets/textures/Plane roughness.png",
                "plane-emission": "assets/textures/A_black_image.jpg",
                "mario": "assets/textures/mario.png",
                "kart": "assets/textures/body_std_mr.png",
                "track": "assets/textures/track.png",
                "tire" : "assets/textures/tire.png",
                "track-shadow": "assets/textures/tc_shadowmap.png"
            },
            "meshes":{
                "cube": "assets/models/cube.obj",
                "monkey": "assets/models/monkey.obj",
                "plane": "assets/models/plane.obj",
                "sphere": "assets/models/sphere.obj",
                "mario": "assets/models/mario.obj",
                "kart": "assets/models/kart.obj",
                "track": "assets/models/track.obj",
                "tire": "assets/models/tire.obj"
            },
            "samplers":{
                "default":{},
                "pixelated":{
                    "MAG_FILTER": "GL_NEAREST"
                }
            },
            "materials":{
                "track": {
                    "type": "lit",
                    "shader": "light",
                    "pipelineState": {
                        "faceCulling":{
                            "enabled": false
                        },
                        "depthTesting":{
                            "enabled": true
                        },
                        "blending":{
                            "enabled": true,
                            "destinationFactor": "GL_ONE_MINUS_SRC_ALPHA",
                            "sourceFactor": "GL_SRC_ALPHA",
                            "equation": "GL_FUNC_ADD",
                            "constantColor": [1, 1, 1, 1]

                        },
                        "depthMask": true
                    },
                    "transparent": true,
                    //"texture": "track",
                    "sampler": "default",
                    //"alphaThreshold": 0.01,
                    "roughness": "track",
                    "emission": "plane-emission",
                    "specular": "track",
                    "albedo": "track",
                    "ambientOcclusion": "track"
                },
            
                "tire": {
                    "type": "lit",
                    "shader": "light",
                    "pipelineState": {
                        "faceCulling": {
                            "enabled": false
                        },
                        "depthTesting": {
                            "enabled": true
                        }
                    },

                    //"texture": "tire",
                    "sampler": "default",
                    "roughness": "tire",
                    "emission": "plane-emission",
                    "specular": "tire",
                    "albedo": "tire",
                    "ambientOcclusion": "tire"
                },
                "kart":{
                    "type": "lit",
                    "shader": "light",
                    "pipelineState": {
                        "faceCulling": {
                            "enabled": false
                        },
                        "depthTesting": {
                            "enabled": true
                        }
                    },

                    //"texture": "kart",
                    "sampler": "default",
                    "roughness": "kart",
                    "emission": "plane-emission",
                    "specular": "kart",
                    "albedo": "kart",
                    "ambientOcclusion": "kart"
                },
                "mario":{
                    "type": "lit",
                    "shader": "light",
                    "pipelineState": {
                        "faceCulling": {
                            "enabled": false
                        },
                        "depthTesting": {
                            "enabled": true
                        }
                    },
                    //"texture": "mario",
                    "sampler": "default",
                    "albedo":"mario",
                    "ambientOcclusion": "mario",
                    "emission": "plane-emission",
                    "roughness": "mario",
                    "specular": "mario"

                },
                "monkey":{
                    "type": "lit",
                    "shader": "light",
                    "pipelineState": {
                        "faceCulling":{
                            "enabled": false
                        },
                        "depthTesting":{
                            "enabled": true
                        }
                    },
                    "tint": [1, 1, 1, 1],
                    //"texture": "monkey",
                    "sampler": "default",
                    "albedo":"albedo",
                    "ambientOcclusion": "ambient",
                    "emission": "emission",
                    "roughness": "roughness",
                    "specular": "specular"
                },
                "moon":{
                    "type": "lit",
                    "shader": "light",
                    "pipelineState": {
                        "faceCulling":{
                            "enabled": false
                        },
                        "depthTesting":{
                            "enabled": true
                        }
                    },
                    "tint": [1, 1, 1, 1],
                    //"texture": "moon",
                    "sampler": "default",
                    "albedo":"moon",
                    "ambientOcclusion": "moon",
                    "emission": "moon",
                    "roughness": "roughness",
                    "specular": "specular"
                }
            }
            
        },
